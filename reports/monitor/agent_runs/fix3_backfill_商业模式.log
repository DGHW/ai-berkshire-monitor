        "content": "Command: python3 - <<'EOF'\nshares = 91.6487e8  # 亿股\npx_cum = 35.18      # 08-18 收盘(含息)\npx_ex  = px_cum - 0.55  # 除息参考价\nprint(\"除息参考价:\", round(px_ex,2))\nmc_cum = px_cum*shares/1e8\nmc_ex  = px_ex*shares/1e8\nprint(\"市值 含息 %.1f 亿 / 除息 %.1f 亿\" % (mc_cum, mc_ex))\nttm = 164.36\nprint(\"PE-TTM 含息 %.2f / 除息 %.2f\" % (mc_cum/ttm, mc_ex/ttm))\nprint(\"PE2026E(190亿) 含息 %.2f / 除息 %.2f\" % (mc_cum/190, mc_ex/190))\nprint(\"PE2026E(175亿正常化) 含息 %.2f / 除息 %.2f\" % (mc_cum/175, mc_ex/175))\niv = 3800.0  # 内在价值中枢(亿)\nprint(\"内在价值每股 %.2f 元, 除息后 %.2f 元\" % (iv/shares*1e8, iv/shares*1e8-0.55))\nprint(\"内在涨幅 含息口径 %.2f%% / 除息口径 %.2f%%\" % ((iv/mc_cum-1)*100, ((iv/shares*1e8-0.55)/px_ex-1)*100))\ncons = 3150.0; opt = 4180.0\nprint(\"保守每股 %.2f -> 除息 %.2f, 涨幅 %.2f%%\" % (cons/shares*1e8, cons/shares*1e8-0.55, ((cons/shares*1e8-0.55)/px_ex-1)*100))\nprint(\"乐观每股 %.2f -> 除息 %.2f, 涨幅 %.2f%%\" % (opt/shares*1e8, opt/shares*1e8-0.55, ((opt/shares*1e8-0.55)/px_ex-1)*100))\nbuild_ex = 33.5; add_ex = 29.5\nprint(\"建仓33.5: 距现价 %.2f%%; PE190 %.2fx / PE175 %.2fx; 占除息内在价值 %.1f%%\" % (\n    (px_ex/build_ex-1)*100, build_ex*shares/1e8/190, build_ex*shares/1e8/175,\n    build_ex*shares/1e8/(iv-50.41)*100))\nprint(\"补仓29.5: PE190 %.2fx / PE175 %.2fx; 占除息内在价值 %.1f%%\" % (\n    add_ex*shares/1e8/190, add_ex*shares/1e8/175, add_ex*shares/1e8/(iv-50.41)*100))\nprint(\"含息对照: 34.0对应市值 %.0f 亿 = 3800的 %.1f%%; 30.0 = %.1f%%\" % (\n    34.0*shares/1e8, 34.0*shares/1e8/3800*100, 30.0*shares/1e8/3800*100))\nprint(\"巴菲特中性41.2 vs 现价: %.2f%%\" % ((41.2/px_ex-1)*100))\nprint(\"股息率@34.63: %.2f%%\" % (1.30/px_ex*100))\nprint(\"李录建仓30 vs 段永平补仓29.5: 差 %.1f%%\" % ((30/29.5-1)*100))\n# 大华毛利率差\nprint(\"毛利率差 2026H1: %.2f pct\" % (49.97-43.06))\nEOF\nStdout: 除息参考价: 34.63\r\n市值 含息 3224.2 亿 / 除息 3173.8 亿\r\nPE-TTM 含息 19.62 / 除息 19.31\r\nPE2026E(190亿) 含息 16.97 / 除息 16.70\r\nPE2026E(175亿正常化) 含息 18.42 / 除息 18.14\r\n内在价值每股 41.46 元, 除息后 40.91 元\r\n内在涨幅 含息口径 17.86% / 除息口径 18.14%\r\n保守每股 34.37 -> 除息 33.82, 涨幅 -2